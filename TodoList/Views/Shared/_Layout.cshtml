<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PLAN IT - @ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="~/Content/css-folder/layout/layout-t.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="icon" type="image/x-icon" href="~/Content/images/logo/plan-it-logo-fav.png" />

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img src="~/Content/images/logo/plan-it-logo.png" alt="Plan It Logo" style="height: 25px; width: auto;">
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @if (Session["UserId"] != null)
                    {
                        if (ViewBag.IsUser != null && (bool)ViewBag.IsUser)
                        {
                            <li><a href="@Url.Action("Index", "Todo")"><i class="fa-solid fa-list"></i> Task List</a></li>


                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" onclick="toggleDropdown('accountDropdown')"><i class="fa-solid fa-user"></i> @ViewBag.UserName</a>
                                <ul id="accountDropdown" class="dropdown-menu" style="display: none;">
                                    <li class="user-container">
                                        <div class="user-info">
                                            <p class="user-name">Hello @ViewBag.UserName,</p>
                                            <p class="user-email">@ViewBag.UserEmail</p>
                                        </div>
                                    </li>
                                    <li class="logout"><a href="@Url.Action("Logout", "Account")"><i class="fa-solid fa-arrow-right-from-bracket"></i> Log out</a></li>
                                </ul>
                            </li>
                        }
                    }
                    else
                    {
                        <li><a href="@Url.Action("Register", "Account")"><i class="fa-solid fa-unlock"></i> Sign Up</a></li>
                        <li><a href="@Url.Action("Login", "Account")"><i class="fa-regular fa-user"></i> Log in</a></li>
                    }
                </ul>

            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>PlanIt &copy; @DateTime.Now.Year - All rights reserved.</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>

<script>

    document.addEventListener("DOMContentLoaded", function () {
        // Dropdown tıklandığında açılacak
        document.querySelectorAll('.dropdown-toggle').forEach(function (dropdown) {
            dropdown.addEventListener('click', function (e) {
                e.stopPropagation();
                var menu = this.nextElementSibling;
                menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';
            });
        });

        // Sayfanın başka bir yerine tıklandığında dropdown kapanacak
        document.addEventListener('click', function () {
            document.querySelectorAll('.dropdown-menu').forEach(function (menu) {
                menu.style.display = 'none';
            });
        });

        // Dropdown menünün içi tıklanırsa kapanmayı engelle
        document.querySelectorAll('.dropdown-menu').forEach(function (menu) {
            menu.addEventListener('click', function (e) {
                e.stopPropagation();
            });
        });
    });

</script>