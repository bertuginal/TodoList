@{
    ViewBag.Title = "Log in";
}

<link href="~/Content/css-folder/account/login-t.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="login-page">
        <div class="form-horizontal">
            <div class="title-text">
                <p class="hello-text">Hello,</p>
                <p class="welcome-text">welcome!</p>
            </div>

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.Label("Username*", new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <input type="text" name="username" class="form-control" placeholder="How should we call you?"/>
                </div>
            </div>


            <div class="form-group">
                <div class="input-group-append">
                    @Html.Label("Password*", new { @class = "control-label col-md-2" })
                    <button type="button" class="btn btn" id="togglePassword" onclick="togglePasswordVisibility()">
                        🙈
                    </button>
                </div>
                <div class="col-md-10">
                    <div class="input-group">
                        <input type="password" id="passwordInput" name="password" class="form-control" placeholder="••••••••••••••"/>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="login-options row">
                    <div class="col-md-6 remember-me">
                        <input type="checkbox" class="remember-me-checkbox"/> Remember me!
                    </div>
                    <div class="col-md-6 forget-password">
                        <a href="#">Forget password?</a>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10 btn-container">
                    <input type="submit" value="Login" class="btn btn-login" />
                    @Html.ActionLink("Sign Up", "Register", null, new { @class = "btn btn-register" })
                </div>
            </div>

            <div class="form-group">
                <div class="social-media-container">
                    <p class="follow-text">FOLLOW</p>
                    <a href="#" class="btn-social"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="btn-social"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#" class="btn-social"><i class="fa-brands fa-instagram"></i></a>
                </div>
            </div>
        </div>
    </div>
}

<!-- JavaScript -->
<script>
    function togglePasswordVisibility() {
        var passwordInput = document.getElementById("passwordInput");
        var toggleBtn = document.getElementById("togglePassword");

        if (passwordInput.type === "password") {
            passwordInput.type = "text";
            toggleBtn.innerText = "🙉";
        } else {
            passwordInput.type = "password";
            toggleBtn.innerText = "🙈";
        }
    }
</script>
