@model TodoList.Models.Note

@{
    ViewBag.Title = "Edit";
}

<link href="~/Content/css-folder/todo/note/edit.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.HiddenFor(model => model.Id)

    <div class="edit-action">
        <div class="line"></div>
        <div class="icon-container">
            <i class="fas fa-edit"></i>
        </div>
        <div class="line"></div>
    </div>


    <h2>Edit Note?</h2>
    <h4>You can edit your note named "@Html.DisplayFor(model => model.Title)"?</h4>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.LabelFor(model => model.Title, new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label("Reminder (optional)", new { @class = "control-label col-md-2" })
                <div class="col-md-10 date-time-container">
                    <input id="dateInput" class="form-control" type="date" />
                    <input id="timeInput" class="form-control" type="time" />
                    @Html.HiddenFor(model => model.Reminder, new { id = "Reminder" })
                </div>
                @Html.ValidationMessageFor(model => model.Reminder, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Description, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "10" })
            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="btn-container">
            <a href="@Url.Action("NoteIndex", "Todo")" class="btn btn-cancel"><i class="fa-regular fa-circle-left"></i> Cancel</a>
            <button type="submit" class="btn btn-save">
                Save Note <i class="fa-regular fa-circle-right"></i>
            </button>
        </div>
    </div>
</div>
}


<script>
    document.addEventListener("DOMContentLoaded", function () {
        let dateInput = document.getElementById("dateInput");
        let timeInput = document.getElementById("timeInput");
        let hiddenReminder = document.getElementById("Reminder");

        function updateReminder() {
            if (dateInput.value && timeInput.value) {
                hiddenReminder.value = dateInput.value + " " + timeInput.value + ":00";
            }
        }

        dateInput.addEventListener("change", updateReminder);
        timeInput.addEventListener("change", updateReminder);
    });
</script>