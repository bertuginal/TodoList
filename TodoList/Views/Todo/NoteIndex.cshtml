@model IEnumerable<TodoList.Models.Note>

@{
    ViewBag.Title = "Todo List";
}

<link href="~/Content/css-folder/todo/note/index-to.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<a href="@Url.Action("NoteCreate")" class="add-todo-btn"><i class="fa-solid fa-plus"></i></a>

<div class="todo-list">
    @foreach (var item in Model)
    {
        <div class="todo-item">
            <div class="todo-header" onclick="toggleDescription(this)">
                <span class="note-title">@Html.DisplayFor(modelItem => item.Title)</span>
                <div class="btn-actions">
                    <a href="@Url.Action("NoteEdit", new { id = item.Id })" class="action-btn btn-edit"><i class="fa-regular fa-pen-to-square"></i></a>
                    <a href="@Url.Action("NoteDelete", new { id = item.Id })" class="action-btn btn-delete"><i class="fa-regular fa-trash-can"></i></a>
                </div>
            </div>
            <div class="todo-description" style="display: none;">
                <div class="note-description">
                    <strong>Description:</strong> @Html.DisplayFor(modelItem => item.Description)
                </div>
                <div class="note-description">
                    <strong>Created Date:</strong> @item.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                </div>
                <div class="note-description">
                    <strong>Reminder Date:</strong> @item.Reminder.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    }
</div>

<script>
    function toggleDescription(element) {
        var description = element.nextElementSibling;
        if (description) {
            description.style.display = description.style.display === "none" ? "block" : "none";
        }
    }

</script>
