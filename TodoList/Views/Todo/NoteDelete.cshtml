@model TodoList.Models.Note

@{
    ViewBag.Title = "Delete";
}

<link href="~/Content/css-folder/todo/note/delete-t.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="delete-card">

    <div class="dl-horizontal">
        <div class="delete-action">
            <div class="line"></div>
            <div class="icon-container">
                <i class="fa-solid fa-trash-can"></i>
            </div>
            <div class="line"></div>
        </div>

        <h2>Delete Note?</h2>
        <h4>Are you sure you want to delete your note named "@Html.DisplayFor(model => model.Title)"?</h4>

        <div class="card">
            <div class="card-content">
                <div class="card-item">
                    <div class="label-box">
                        <strong>Title:</strong>
                    </div>
                    <div class="value-box">
                        <span>@Html.DisplayFor(model => model.Title)</span>
                    </div>
                </div>

                <div class="card-item">
                    <div class="label-box">
                        <strong>Description:</strong>
                    </div>
                    <div class="value-box">
                        <span>@Html.DisplayFor(model => model.Description)</span>
                    </div>
                </div>

                <div class="card-item">
                    <div class="label-box">
                        <strong>Created Date:</strong>
                    </div>
                    <div class="value-box">
                        <span>@Html.DisplayFor(model => model.CreatedDate)</span>
                    </div>
                </div>

                <div class="card-item">
                    <div class="label-box">
                        <strong>Reminder Time:</strong>
                    </div>
                    <div class="value-box">
                        <span>@Html.DisplayFor(model => model.Reminder)</span>
                    </div>
                </div>
            </div>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions">
                <input type="submit" value="Delete" class="btn btn-danger" />
                @Html.ActionLink("Cancel", "NoteIndex", null, new { @class = "btn btn-cancel" })
            </div>
        }
    </div>
</div>