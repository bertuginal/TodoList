@model IEnumerable<TodoList.Models.Category>

@{
    ViewBag.Title = "Category List";
}

<link href="~/Content/css-folder/category/index.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="category-container">
    <p class="category-title">Select category</p>
    <div class="category-list">
        @foreach (var item in Model)
        {
            <a href="@Url.Action("CategoryNotes", "Todo", new { categoryId = item.Id })" class="category-item">
                <div class="category-link">
                    <span class="category-name">@item.Name</span>
                    <span class="note-count">@item.Notes.Count()</span>
                </div>
            </a>

        }

        <a href="@Url.Action("Create", "Category")" class="create-category-item">
            <div class="create-category-link">
                <i class="fa-solid fa-plus"></i>
                <span>New Category</span>
            </div>
        </a>


    </div>
</div>
