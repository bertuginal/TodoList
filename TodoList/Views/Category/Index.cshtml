@model IEnumerable<TodoList.Models.Category>

@{
    ViewBag.Title = "Category List";
}

<link href="~/Content/css-folder/category/index-n.css" rel="stylesheet" type="text/css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="category-container">
    <p class="category-title">Select category</p>
    <div class="category-list">
        @foreach (var item in Model)
        {
            <form method="post" action="@Url.Action("Index", "Category")">
                <input type="hidden" name="noteId" value="@ViewBag.NoteId" />
                <input type="hidden" name="categoryId" value="@item.Id" />
                <button type="submit" class="category-item">
                    <span class="category-name">@item.Name</span>
                    <span class="note-count">
                        @item.Notes.Where(n => n.UserId == (int)Session["UserId"]).Count()
                    </span>
                </button>
            </form>
        }


        <a href="@Url.Action("Create", "Category")" class="create-category-item">
            <div class="create-category-link">
                <i class="fa-solid fa-plus"></i>
                <span>New Category</span>
            </div>
        </a>
    </div>
</div>
